# Copy to .env and adjust for your environment.
DATABASE_URL="file:./dev.db"
PORT=4000
HOST=0.0.0.0
JWT_SECRET="change-me-to-a-long-random-string"
COOKIE_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Hosting / split deployments ------------------------------------------------
# Comma-separated exact origins allowed to call the API (restaurant app and
# customer site when they are hosted separately, e.g. on Netlify).
# CORS_ORIGIN="https://admin.example.com,https://order.example.com"
# Optional regex for Netlify deploy previews.
# CORS_ORIGIN_REGEX="^https://[a-z0-9-]+--lumiere-ops\\.netlify\\.app$"
# Set when running behind a reverse proxy / load balancer.
# TRUST_PROXY=true
# The backend serves ../customer-site at / by default; disable when hosting the
# customer site separately.
# SERVE_CUSTOMER_SITE=false
# Optional override for the static customer site directory.
# CUSTOMER_SITE_DIR="../customer-site"
# Uploaded menu photos (defaults to ./uploads).
# UPLOADS_DIR="/data/uploads"
# Only needed for cookie-based clients across domains; the restaurant app uses
# the Bearer token, so this is normally left off.
# COOKIE_CROSS_SITE=true

# Optional -------------------------------------------------------------------
# HMAC secret for customer table sessions (QR/NFC placards).
SESSION_HMAC_SECRET="change-me-to-a-long-random-string"
# Require this key on /api/integration/* when an external system pushes statuses.
# INTEGRATION_API_KEY=""
